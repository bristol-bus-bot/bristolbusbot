# See src/config/app-config.ts for the full list.
AI_API_KEY=
# Optional: a cheaper model for the pass/fail checker (defaults to AI_MODEL).
AI_VERIFIER_MODEL=
# Optional: "vertex" bills Gemini to the Google Cloud account instead of AI Studio.
AI_PROVIDER=
VERTEX_PROJECT=
VERTEX_LOCATION=global
BODS_API_KEY=
BSKY_HANDLE=bristolbusbot.live
BSKY_APP_PASSWORD=
WEATHER_API_KEY=
# Optional traffic subject; enable only after checking the account allowance and coverage.
TOMTOM_API_KEY=
TRAFFIC_ENABLED=false
TRAFFIC_USAGE_PATH=/var/lib/bristolbusbot/bot/traffic-usage.json
TEST_MODE=true
INGEST_MODE=events
LIVE_DB_PATH=/var/lib/bristolbusbot/collector/live.db
EDITORIAL_CONTEXT_PATH=/var/lib/bristolbusbot-editorial/editorial-context.json
EDITORIAL_USAGE_PATH=/var/lib/bristolbusbot/bot/editorial-usage.json
PORT=3010
# Required outside test mode. Generate at least 32 random characters; never
# copy a real value into this tracked example.
API_AUTH_TOKEN=

[Unit]
Description=Run the completed-day audit rollup daily

[Timer]
# Some Friday/Saturday timetable journeys start at 29:42 (05:42 the next
# morning).  Leave another hour for them to appear before closing the day.
OnCalendar=*-*-* 07:00:00
Persistent=true
AccuracySec=1min
RandomizedDelaySec=30s
Unit=bbb-audit-rollup.service

[Install]
WantedBy=timers.target

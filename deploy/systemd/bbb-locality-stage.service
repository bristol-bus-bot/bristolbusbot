[Unit]
Description=Stage the accepted Bristol Bus Bot stop-locality candidate
After=bbb-locality-refresh.service bbb-locality-shadow.service
OnSuccess=bbb-enrichment-promote@localities.service

[Service]
Type=oneshot
User=@BBB_DEPLOY_USER@
Group=@BBB_DEPLOY_USER@
ExecStart=/usr/local/libexec/bbb-run-recorded-job --name locality-stage -- /usr/bin/flock -w 900 -E 73 /run/lock/bristolbusbot/heavy-io.lock /usr/bin/python3 /usr/local/libexec/bristolbusbot-enrichment/locality_candidate_stage.py
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/var/lib/bristolbusbot/locality-shadow/stop_localities.json /var/lib/bristolbusbot/monitoring/locality-shadow.json /var/lib/bristolbusbot/enrichment/stop_localities.json /var/lib/bristolbusbot/pipeline/timetable.db
ReadWritePaths=/var/lib/bristolbusbot/enrichment/incoming /var/lib/bristolbusbot/monitoring /run/lock/bristolbusbot
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
